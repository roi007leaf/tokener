<div class='pf2e-tokener-custom-folders'>
  <p class='notes'>{{hint}}</p>

  <div class='pf2e-tokener-custom-folder-list'>
    {{#each folders}}
      <div class='pf2e-tokener-custom-folder-row' data-folder-index='{{index}}'>
        <input
          type='text'
          name='folders.{{index}}.title'
          value='{{title}}'
          placeholder='{{titlePlaceholder}}'
        />

        <div class='pf2e-tokener-custom-folder-path'>
          <input
            type='text'
            name='folders.{{index}}.path'
            value='{{path}}'
            placeholder='{{pathPlaceholder}}'
          />
          <button
            class='file-picker'
            type='button'
            data-type='folder'
            data-target='folders.{{index}}.path'
            data-tooltip='{{browseLabel}}'
            data-tooltip-direction='UP'
          >
            <i class='fas fa-folder-open' aria-hidden='true'></i>
          </button>
          <button
            type='button'
            data-folder-action='remove'
            data-folder-index='{{index}}'
            data-tooltip='{{removeLabel}}'
            data-tooltip-direction='UP'
          >
            <i class='fas fa-trash' aria-hidden='true'></i>
          </button>
        </div>

        <section class='pf2e-tokener-custom-folder-tags'>
          <div class='pf2e-tokener-custom-folder-tags-title'>{{tagsLabel}}</div>
          {{#if tagGroups.length}}
            <div class='pf2e-tokener-custom-folder-tag-groups'>
              {{#each tagGroups}}
                <details class='pf2e-tokener-custom-folder-tag-group'>
                  <summary class='pf2e-tokener-custom-folder-tag-summary'>
                    <label class='pf2e-tokener-custom-folder-tag-label'>
                      <input type='checkbox' data-folder-tag-group='{{id}}' {{selectedAttribute}} />
                      <span>{{label}}</span>
                    </label>
                  </summary>
                  <div class='pf2e-tokener-custom-folder-tag-options'>
                    {{#each options}}
                      <label class='pf2e-tokener-custom-folder-tag-option'>
                        <input
                          type='checkbox'
                          name='{{inputName}}'
                          value='{{id}}'
                          data-folder-tag-id='{{id}}'
                          data-folder-tag-group-id='{{group}}'
                          {{checkedAttribute}}
                        />
                        <span>{{label}}</span>
                      </label>
                    {{/each}}
                  </div>
                </details>
              {{/each}}
            </div>
          {{else}}
            <p class='notes'>{{tagsEmptyLabel}}</p>
          {{/if}}
        </section>
      </div>
    {{/each}}
  </div>

  <button class='pf2e-tokener-custom-folder-add' type='button' data-folder-action='add'>
    <i class='fas fa-plus' aria-hidden='true'></i>
    {{addLabel}}
  </button>
</div>